{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shayne/hyperpixel2r-kms/releases/driver-manifest.schema.json",
  "title": "HyperPixel 2 Round KMS driver release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "driver_version",
    "source",
    "supported",
    "reproducibility",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "driver_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree", "date_epoch"],
      "properties": {
        "repository": { "const": "https://github.com/shayne/hyperpixel2r-kms" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "date_epoch": { "type": "integer", "minimum": 0 }
      }
    },
    "supported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["board", "display", "operating_system", "architecture", "kernel_policy"],
      "properties": {
        "board": { "const": "Raspberry Pi Zero 2 W" },
        "display": { "const": "HyperPixel 2.1 Round" },
        "operating_system": { "const": "Raspberry Pi OS Lite (Trixie, 64-bit)" },
        "architecture": { "const": "aarch64" },
        "kernel_policy": { "const": "exact-release-only" }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive_format", "source_date_epoch", "owner", "group", "mode_policy"],
      "properties": {
        "archive_format": { "const": "tar+zstd" },
        "source_date_epoch": { "type": "integer", "minimum": 0 },
        "owner": { "const": 0 },
        "group": { "const": 0 },
        "mode_policy": { "const": "git-executable-or-regular" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": { "kind": { "const": "source-archive" } },
            "required": ["kind"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": { "kind": { "const": "sbom" } },
            "required": ["kind"]
          }
        }
      ],
      "items": {
        "type": "object",
        "oneOf": [
          {
            "additionalProperties": false,
            "required": ["name", "kind", "sha256", "size"],
            "properties": {
              "name": { "const": "hyperpixel2r-kms-source.tar.zst" },
              "kind": { "const": "source-archive" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "size": { "type": "integer", "minimum": 1 }
            }
          },
          {
            "additionalProperties": false,
            "required": ["name", "kind", "sha256", "size"],
            "properties": {
              "name": { "const": "SBOM.spdx.json" },
              "kind": { "const": "sbom" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "size": { "type": "integer", "minimum": 1 }
            }
          },
          {
            "additionalProperties": false,
            "required": [
              "name",
              "kind",
              "sha256",
              "size",
              "architecture",
              "kernel_release",
              "vermagic",
              "bundle_manifest_sha256"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^hyperpixel2r-kms-[A-Za-z0-9._+-]+-aarch64\\.tar\\.zst$"
              },
              "kind": { "const": "exact-kernel-bundle" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "size": { "type": "integer", "minimum": 1 },
              "architecture": { "const": "aarch64" },
              "kernel_release": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._+-]+$"
              },
              "vermagic": {
                "type": "string",
                "pattern": "^[-A-Za-z0-9._+ ]{1,512}$"
              },
              "bundle_manifest_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        ]
      }
    }
  }
}
